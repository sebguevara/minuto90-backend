{
  "name": "minuto90-backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "worker": "bun run src/workers/index.ts",
    "worker:poll-live": "bun run src/workers/live-fixtures-poller.ts",
    "worker:pre-match": "bun run src/workers/pre-match-notifications.worker.ts",
    "worker:news-push": "bun run src/workers/news-publication-poller.worker.ts",
    "worker:match-news": "bun run src/workers/match-news-generation.worker.ts",
    "worker:web-push": "bun run src/workers/web-push-notifications.worker.ts",
    "worker:whatsapp": "bun run src/workers/whatsapp-notifications.worker.ts",
    "worker:daily-prewarm": "bun run src/workers/daily-prewarm.worker.ts",
    "worker:odds-prewarm": "bun run src/workers/odds-prewarm.worker.ts",
    "cache:refresh": "bun run src/scripts/refresh-redis.ts",
    "cache:refresh:football": "bun run src/scripts/refresh-redis.ts football",
    "cache:seed:odds": "bun run src/scripts/seed-odds-mappings.ts",
    "postinstall": "bunx prisma generate --schema ./prisma-minuto/schema.prisma && bunx prisma generate --schema ./prisma-whoscored/schema.prisma",
    "generate": "bunx prisma generate --schema ./prisma-minuto/schema.prisma && bunx prisma generate --schema ./prisma-whoscored/schema.prisma",
    "migrate": "bunx prisma migrate dev --schema ./prisma-minuto/schema.prisma && bunx prisma migrate dev --schema ./prisma-whoscored/schema.prisma",
    "deploy": "bunx prisma migrate deploy --schema ./prisma-minuto/schema.prisma && bunx prisma migrate deploy --schema ./prisma-whoscored/schema.prisma",
    "studio": "bunx prisma studio --schema ./prisma-minuto/schema.prisma --port 5555 & bunx prisma studio --schema ./prisma-whoscored/schema.prisma --port 5556"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@elysiajs/openapi": "^1.4.15",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@toon-format/toon": "^2.2.0",
    "bullmq": "^5.76.8",
    "cron": "^4.4.0",
    "cronbake": "^0.4.0",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.28",
    "elysia-rate-limit": "^4.6.2",
    "fast-average-color": "^9.5.2",
    "fast-xml-parser": "^5.8.0",
    "ioredis": "^5.10.1",
    "openai": "^6.37.0",
    "pg": "^8.20.0",
    "prismabox": "^1.1.26",
    "svix": "^1.93.0",
    "tsx": "^4.22.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "bun-types": "latest",
    "prisma": "^7.8.0"
  },
  "overrides": {
    "bn.js": "^4.12.3"
  },
  "module": "src/index.js"
}
